           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.faforever.client.teammatchmaking.TeamMatchmakingMapTileController">
    <StackPane prefWidth="178.0" prefHeight="178.0" style="-fx-background-radius: 6;">
